pipeline {
    agent any
    tools {
        // Usa el nombre que configuraste en Global Tool Configuration
        nodejs 'node' 
    }
    environment {
        // Lógica condicional: Si la rama es 'main', usa 3000. Si no, usa 3001.
        HOST_PORT = "${env.BRANCH_NAME == 'main' ? '3000' : '3001'}"
        IMAGE_NAME = "node${env.BRANCH_NAME}:v1.0"
        CONTAINER_NAME = "app_${env.BRANCH_NAME}"
    }
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh 'npm install'
            }
        }
        stage('Test') {
            steps {
                sh 'npm test || echo "No tests provided"'
            }
        }
        stage('Docker build') {
            steps {
                sh "docker build -t ${IMAGE_NAME} ."
            }
        }
        stage('Deploy') {
            steps {
                // Tarea Avanzada: Solo detiene y borra el contenedor del entorno actual.
                // El "|| true" evita que el pipeline falle si el contenedor no existe la primera vez.
                sh """
                docker stop ${CONTAINER_NAME} || true
                docker rm ${CONTAINER_NAME} || true
                docker run -d -p ${HOST_PORT}:3000 --name ${CONTAINER_NAME} ${IMAGE_NAME}
                """
            }
        }
    }
}
