pipeline {
    agent any
    tools {
        // Asegúrate de que tu herramienta NodeJS esté configurada con este nombre en Global Tool Configuration
        nodejs 'node' 
    }
    environment {
        // Si BRANCH_NAME viene nula (pipeline manual), toma el valor del parámetro BRANCH_TO_DEPLOY. Si no, usa BRANCH_NAME.
        TARGET_BRANCH = "${env.BRANCH_NAME ?: params.BRANCH_TO_DEPLOY}"
        
        // Asignación condicional de puertos: 3000 para main, 3001 para cualquier otra rama o entorno
        HOST_PORT = "${(env.BRANCH_NAME == 'main' || params.BRANCH_TO_DEPLOY == 'main') ? '3000' : '3001'}"
        
        // Nombre seguro para la rama/entorno evitando nulos
        SAFE_BRANCH = "${(env.BRANCH_NAME && env.BRANCH_NAME != 'null') ? env.BRANCH_NAME : params.BRANCH_TO_DEPLOY}"
    }
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh 'npm install'
            }
        }
        stage('Test') {
            steps {
                sh 'npm test || echo "Saltando pruebas"'
            }
        }
        stage('Docker build') {
            steps {
                sh "docker build -t node${SAFE_BRANCH}:v1.0 ."
            }
        }
        stage('Deploy') {
            steps {
                // Detiene y elimina de forma segura cualquier contenedor previo del entorno para liberar puertos
                sh """
                docker stop app_${SAFE_BRANCH} || true
                docker rm app_${SAFE_BRANCH} || true
                
                docker run -d -p ${HOST_PORT}:3000 --name app_${SAFE_BRANCH} node${SAFE_BRANCH}:v1.0
                """
            }
        }
    }
}
